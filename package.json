{
  "name": "sajtoskop",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "scan": "tsx apps/cli/src/index.ts",
    "harvest": "tsx apps/cli/src/harvest-emails.ts",
    "seed": "tsx apps/cli/src/seed.ts",
    "check:sql": "tsx scripts/validate-migrations.ts",
    "check:f1": "tsx apps/cli/src/checks.ts",
    "check:f4": "tsx scripts/check-unlock.ts",
    "backfill:screenshots": "tsx scripts/backfill-screenshots.ts",
    "backfill:ai": "tsx scripts/backfill-ai.ts",
    "probe:ai": "tsx scripts/probe-ai.ts",
    "rescore": "tsx scripts/rescore-audits.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "dev": "pnpm --filter @sajtoskop/web dev",
    "build": "pnpm --filter @sajtoskop/web build",
    "test": "pnpm -r test",
    "worker": "pnpm --filter @sajtoskop/worker start"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.10.0"
}
