# Prepiši u `.env` i popuni. `.env` je u .gitignore i tu ostaje.
# Vercel i Hetzner dobijaju iste vrednosti kroz svoje env panele, ne kroz fajl.

# ── Google ─────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# PageSpeed Insights. Bez ključa PSI radi, ali sa kvotom po IP-u koja pukne
# posle nekoliko poziva — na Hetzneru to znači „radi u testu, ne u produkciji".
PSI_API_KEY=

# ── Supabase ───────────────────────────────────────────────
# Project Settings → API. URL i anon ključ smeju u pregledač; service_role NE SME.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Zaobilazi RLS. Nikad sa NEXT_PUBLIC_ prefiksom, nikad u "use client" fajlu.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → endpoint → Signing Secret (počinje sa `whsec_`).
# Bez ovoga je /api/webhooks/clerk javni upis u bazu.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Anthropic (F6) ─────────────────────────────────────────
# ‼️ PRE nego što ovo popuniš: postavi spend limit u Anthropic konzoli
#    (platform.claude.com/settings/billing → Spend limits → Set limit).
#    NIJE /settings/limits — tamo su rate limitovi, koji ne štite novčanik.
#    Ovo je jedini ključ u repou iza koga stoji potrošnja po zahtevu, a ne
#    mesečna kvota koja se sama resetuje.
# Bez ključa AI korak u `enrich_full` tiho otpada, a lead ostaje na audit_level 2 —
# sa skorom, snimcima i PSI-jem. Ništa se ne ruši.
ANTHROPIC_API_KEY=
# Samo za `pnpm probe:ai`, kad porediš kvalitet i cenu modela. Prazno = Sonnet.
ANTHROPIC_MODEL=

# ── Resend: utisci iz bete (F10) i admin pošta (F12.3) ─────
# Bez RESEND_API_KEY aplikacija radi normalno: utisak se upiše u tabelu
# `feedback`, mejl se preskoči, a razlog stoji u koloni `email_error`.
#
# Od F12.3 kroz isti ključ ide i pošta koja stiže DRUGIM ljudima: pozivnica u
# betu, pristup za nalog otvoren iz konzole i pojedinačna poruka korisniku. Bez
# ključa se pozivnica i dalje napravi u Clerku i link se prikaže u konzoli, ali
# mejl ne ode — a „Pošalji poruku" tada uvek pada.
RESEND_API_KEY=
# Moj inboks — adresa na koju stižu utisci i na koju ide `Reply-To` svakog
# mejla koji konzola pošalje korisniku.
FEEDBACK_EMAIL_TO=
# Sa imenom pošiljaoca, npr. `Sajtoskop <feedback@sajtoskop.com>`.
# Domen mora biti verifikovan u Resend-u, inače svaki poziv vraća 403.
FEEDBACK_EMAIL_FROM=

# ── Admin konzola (F12) ────────────────────────────────────
# Clerk ID-jevi (`user_...`) razdvojeni zarezom, koji su admini BEZ OBZIRA na
# `profiles.role`. Rešava dva problema: prvog admina (nema ga ko postavi u bazi)
# i zaključavanje (degradirao sam sam sebe u 2 ujutru).
#
# Prazno NIJE greška — tada admini postoje samo u bazi. Ako ih tamo nema
# nijednog, `/admin` je 404 za sve, a aplikacija se i dalje normalno podiže.
# Spisak se nigde ne prikazuje u UI-ju i ne izlazi iz procesa.
ADMIN_BOOTSTRAP_IDS=

# ── Cron (F11.3) ───────────────────────────────────────────
# Jedina prepreka ispred `/api/cron/*`. Bez nje sve tri rute vraćaju 404 i
# nijedan zakazan posao ne radi — ni digest, ni izveštaj, ni čišćenje slika.
#
# Vrednost je bilo koji nasumičan string od bar 16 znakova:
#   openssl rand -base64 32
#
# Na Vercelu se zove BAŠ tako (`CRON_SECRET`) — platforma je sama šalje kao
# `Authorization: Bearer …` uz svaki zakazan poziv. Ista tajna radi i kroz
# `x-cron-secret`, što je jednostavnije za ručno pokretanje.
#
# ‼️ Raspored je u `apps/web/vercel.json` i u UTC-u — Vercel cron ne poznaje
#    vremenske zone. `0 19 * * *` je 21:00 po Beogradu leti, a 20:00 zimi.
#
# ‼️ Hobby plan dozvoljava najviše DVA cron posla, i oba najviše jednom dnevno.
#    Zakazana su zato samo ova dva:
#      /api/cron/utisci-digest     0 19 * * *   (dnevno)
#      /api/cron/utisci-izvestaj   0 7 * * 1    (ponedeljkom)
#    Treći, `/api/cron/utisci-slike`, NIJE zakazan i pokreće se rukom — v.
#    „S6 — ručni koraci" u docs/SESIJE.md.
CRON_SECRET=

# ── Worker ─────────────────────────────────────────────────
SUPABASE_DB_URL=
WORKER_CONCURRENCY=3

# Dnevni capovi za ne-Google pozive. Prazno = vrednosti iz packages/shared/src/plans.ts
# (PSI 120, AI 60). Postoje kao izlaz u nuždi, ne kao podrazumevano podešavanje.
PSI_DAILY_LIMIT=
AI_DAILY_LIMIT=
