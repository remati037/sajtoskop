# Prepiši u `.env` i popuni. `.env` je u .gitignore i tu ostaje.
# Vercel i Hetzner dobijaju iste vrednosti kroz svoje env panele, ne kroz fajl.

# ── Google ─────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# PageSpeed Insights. Bez ključa PSI radi, ali sa kvotom po IP-u koja pukne
# posle nekoliko poziva — na Hetzneru to znači „radi u testu, ne u produkciji".
PSI_API_KEY=

# ── Supabase ───────────────────────────────────────────────
# Project Settings → API. URL i anon ključ smeju u pregledač; service_role NE SME.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Zaobilazi RLS. Nikad sa NEXT_PUBLIC_ prefiksom, nikad u "use client" fajlu.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → endpoint → Signing Secret (počinje sa `whsec_`).
# Bez ovoga je /api/webhooks/clerk javni upis u bazu.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Anthropic (F6) ─────────────────────────────────────────
# ‼️ PRE nego što ovo popuniš: postavi spend limit u Anthropic konzoli
#    (platform.claude.com/settings/billing → Spend limits → Set limit).
#    NIJE /settings/limits — tamo su rate limitovi, koji ne štite novčanik.
#    Ovo je jedini ključ u repou iza koga stoji potrošnja po zahtevu, a ne
#    mesečna kvota koja se sama resetuje.
# Bez ključa AI korak u `enrich_full` tiho otpada, a lead ostaje na audit_level 2 —
# sa skorom, snimcima i PSI-jem. Ništa se ne ruši.
ANTHROPIC_API_KEY=
# Samo za `pnpm probe:ai`, kad porediš kvalitet i cenu modela. Prazno = Sonnet.
ANTHROPIC_MODEL=

# ── Resend: utisci iz bete (F10) i admin pošta (F12.3) ─────
# Bez RESEND_API_KEY aplikacija radi normalno: utisak se upiše u tabelu
# `feedback`, mejl se preskoči, a razlog stoji u koloni `email_error`.
#
# Od F12.3 kroz isti ključ ide i pošta koja stiže DRUGIM ljudima: pozivnica u
# betu, pristup za nalog otvoren iz konzole i pojedinačna poruka korisniku. Bez
# ključa se pozivnica i dalje napravi u Clerku i link se prikaže u konzoli, ali
# mejl ne ode — a „Pošalji poruku" tada uvek pada.
RESEND_API_KEY=
# Moj inboks — adresa na koju stižu utisci i na koju ide `Reply-To` svakog
# mejla koji konzola pošalje korisniku.
FEEDBACK_EMAIL_TO=
# Sa imenom pošiljaoca, npr. `Sajtoskop <feedback@sajtoskop.com>`.
# Domen mora biti verifikovan u Resend-u, inače svaki poziv vraća 403.
FEEDBACK_EMAIL_FROM=

# ── Admin konzola (F12) ────────────────────────────────────
# Clerk ID-jevi (`user_...`) razdvojeni zarezom, koji su admini BEZ OBZIRA na
# `profiles.role`. Rešava dva problema: prvog admina (nema ga ko postavi u bazi)
# i zaključavanje (degradirao sam sam sebe u 2 ujutru).
#
# Prazno NIJE greška — tada admini postoje samo u bazi. Ako ih tamo nema
# nijednog, `/admin` je 404 za sve, a aplikacija se i dalje normalno podiže.
# Spisak se nigde ne prikazuje u UI-ju i ne izlazi iz procesa.
ADMIN_BOOTSTRAP_IDS=

# ── Cron (F11.3) ───────────────────────────────────────────
# Jedina prepreka ispred `/api/cron/*`. Bez nje sve tri rute vraćaju 404 i
# nijedan zakazan posao ne radi — ni digest, ni izveštaj, ni čišćenje slika.
#
# Vrednost je bilo koji nasumičan string od bar 16 znakova:
#   openssl rand -base64 32
#
# Na Vercelu se zove BAŠ tako (`CRON_SECRET`) — platforma je sama šalje kao
# `Authorization: Bearer …` uz svaki zakazan poziv. Ista tajna radi i kroz
# `x-cron-secret`, što je jednostavnije za ručno pokretanje.
#
# ‼️ Raspored je u `apps/web/vercel.json` i u UTC-u — Vercel cron ne poznaje
#    vremenske zone. `0 19 * * *` je 21:00 po Beogradu leti, a 20:00 zimi.
#
# ‼️ Hobby plan dozvoljava najviše DVA cron posla, i oba najviše jednom dnevno.
#    Zakazana su zato samo ova dva:
#      /api/cron/utisci-digest     0 19 * * *   (dnevno)
#      /api/cron/utisci-izvestaj   0 7 * * 1    (ponedeljkom)
#    Treći, `/api/cron/utisci-slike`, NIJE zakazan i pokreće se rukom — v.
#    „S6 — ručni koraci" u docs/SESIJE.md.
CRON_SECRET=

# ── Worker ─────────────────────────────────────────────────
SUPABASE_DB_URL=
WORKER_CONCURRENCY=3

# Dnevni capovi za ne-Google pozive. Prazno = vrednosti iz packages/shared/src/plans.ts
# (PSI 120, AI 60). Postoje kao izlaz u nuždi, ne kao podrazumevano podešavanje.
PSI_DAILY_LIMIT=
AI_DAILY_LIMIT=

# ── Places budžet (S16) ────────────────────────────────────
# Koliko sam mesečno spreman da platim PREKO Googleovog besplatnog praga, u
# evrima. Prazno = 60.
#
# Iz ovoga se RAČUNAJU globalni kapovi u packages/shared/src/plans.ts:
#   GLOBAL_MONTHLY_API_CAP = 1.000 + budžet / 0,032  ≈ 2.875 poziva
#   GLOBAL_DAILY_API_CAP   = mesečni / 20            ≈ 143 poziva
#
# ‼️ SKU je Places Text Search **ENTERPRISE** ($35 na 1.000 poziva, i samo
#    **1.000** besplatnih mesečno) jer FIELD_MASK traži nationalPhoneNumber i
#    websiteUri. Essentials red u Googleovoj tabeli kaže 10.000 besplatnih i NE
#    ODNOSI SE na nas — pogrešan red daje budžet deset puta veći nego što jeste.
#
# ‼️ OVAJ BROJ MORA DA RASTE SA BROJEM PRETPLATNIKA. Jedan Advanced korisnik
#    (800 kredita) u najgorem režimu sam pojede skoro trećinu kapa. Odbijeno
#    skeniranje plaćenom korisniku je povraćaj i loša reč — skuplje od svakog
#    Places računa. Ulazi u nedeljnu proveru: tempo iz `api_budget` naspram
#    broja aktivnih pretplata.
PLACES_MONTHLY_BUDGET_EUR=

# Tvrdo gaženje izračunatih kapova, za slučaj nužde. Prazno = računato iz
# budžeta iznad. Postoji od F3 i ostaje — v. apps/worker/src/lib/api-budget.ts.
GOOGLE_MONTHLY_LIMIT=
GOOGLE_DAILY_LIMIT=

# ── Paddle: naplata i cenovnik ─────────────────────────────
# Klijentski token, iz Paddle > Developer tools > Authentication > Client-side
# tokens. Ide u pregledač i to je u redu — vidi se u `view-source` svakog
# posetioca i sam po sebi ne može ništa osim da otvori checkout. Serverski ključ
# (`pdl_sdbx_…` / `pdl_live_…`) NIKAD ne sme ovde ni bilo gde uz NEXT_PUBLIC_.
#
# `test_` je sandbox token, `live_` je produkcioni. Mora da se poklapa sa
# NEXT_PUBLIC_PADDLE_ENV ispod — nesparen par ne puca nego tiho otvori checkout
# ka DRUGOM Paddle nalogu, gde tih cena nema.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Tačno `sandbox` ili `production`. Nema podrazumevane vrednosti i ne sme da je
# bude: nepodešeno na Vercelu bi značilo checkout u pogrešnu kasu, a to se ne
# primeti dok neko ne plati. Ekran cena zato radije kaže „nije podešeno".
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ‼️ Ručan korak koji se ne može odraditi iz koda: Paddle > Checkout >
#    Checkout settings > Default payment link. Bez njega svaki `Checkout.open()`
#    pukne sa „Something went wrong". U sandboxu sme `http://localhost:3000/`;
#    u produkciji mora pravi, odobren domen — localhost tamo obara naplatu.
#
# ‼️ `pri_` ID-jevi planova stoje u `apps/web/src/lib/cenovnik.ts`, ne ovde.
#    Sandbox i produkcija imaju ODVOJENE kataloge: ID iz jednog ne postoji u
#    drugom. Pri prelasku na produkciju menjaju se sva tri zajedno — ID-jevi,
#    token i NEXT_PUBLIC_PADDLE_ENV.

# ── Paddle: serverski ključevi (S18) ───────────────────────
# ‼️ SVE TRI SU SERVERSKE. Nijedna nikad ne sme uz NEXT_PUBLIC_ prefiks — to bi
#    ih poslalo u pregledač svakog posetioca.
#
# API ključ, iz Paddle > Developer tools > Authentication > API keys.
# `pdl_sdbx_…` je sandbox, `pdl_live_…` produkcija. Njime server pravi
# transakciju sa `custom_data.user_id` iz Clerk sesije — jedini put kojim se
# kupovina vezuje za nalog (pravilo 8: `user_id` nikad iz pregledača).
PADDLE_API_KEY=

# Tajna webhook destinacije (`pdl_ntfset_…`), iz Paddle > Developer tools >
# Notifications > destination. **Ne može da se pročita drugi put** — kopira se
# pri kreiranju. Bez nje je /api/billing/webhook javni endpoint koji deli
# kredite, pa ruta odbija da radi umesto da preskoči proveru.
PADDLE_WEBHOOK_SECRET=

# Popust za beta korisnike (`dsc_…`), kod `BETA2026`, 33%, jednokratan.
# Prazno NIJE greška: tada se popust prosto ne primenjuje sam, a kod se i dalje
# može ukucati u checkout-u. Ograničen je na proizvode pretplata — pakete
# kredita namerno ne hvata.
PADDLE_BETA_DISCOUNT_ID=

# ── Landing (S24) ──────────────────────────────────────────
# Prodajna strana. NIJE u ovom repozitorijumu — živi na svom domenu i deploy-uje
# se odvojeno (`docs/LANSIRANJE.md` §1.7). Aplikacija ide na `app.` poddomen, a
# odavde je vidi samo kao adresu na koju vodi logo i stavka „Početna" u futeru.
#
# ‼️ Kanonski oblik nosi `www`: goli domen odgovara `308` i preusmerava na
#    `www`, pa bi svaki klik iz aplikacije plaćao suvišan skok.
#
# Prazno NIJE greška — pada na podrazumevani domen iz `apps/web/src/lib/veze.ts`.
# Postavlja se i na Vercelu (ručni korak R33).
NEXT_PUBLIC_LANDING_URL=https://www.sajtoskop.com
